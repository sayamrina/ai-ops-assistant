# Copy to .env and fill in. Never commit .env.
OPS_LLM_PROVIDER=openai          # openai | ollama | fake
OPS_OPENAI_API_KEY=
OPS_CHAT_MODEL=gpt-4o-mini
OPS_EMBEDDING_MODEL=text-embedding-3-small
# For Ollama: OPS_LLM_PROVIDER=ollama, OPS_OLLAMA_BASE_URL=http://ollama:11434/v1, OPS_CHAT_MODEL=llama3.1:8b, OPS_EMBEDDING_MODEL=nomic-embed-text

# Output of `python -m app.cli create-key NAME ROLE`, merged into one JSON object
OPS_API_KEYS={}
OPS_WEBHOOK_SECRET=

# Optional integrations (dry-run when empty)
OPS_TEAMS_WEBHOOK_URL=
OPS_JIRA_BASE_URL=
OPS_JIRA_EMAIL=
OPS_JIRA_API_TOKEN=
